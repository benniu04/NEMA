# Copy this file to `.env` and fill in the values.
# All EXPO_PUBLIC_* vars are inlined into the bundle at build time.
# After editing .env, restart Metro with cache cleared: npm start -- -c

# --- Backend (optional) ---
# By default, dev auto-detects the Mac's IP from Metro's host. Set this only
# to override (e.g., point a device at staging).
# EXPO_PUBLIC_API_URL=http://192.168.1.42:5000

# --- Google Sign-In (Firebase project: nema-e66af) ---
# Firebase Web API key — Firebase Console → Project settings → General → Web API Key
EXPO_PUBLIC_FIREBASE_API_KEY=

# iOS OAuth Client ID — Google Cloud Console → Credentials → OAuth client (iOS)
# Bundle ID must match `ios.bundleIdentifier` in app.json (com.benny04327.nema)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android OAuth Client ID (only needed when testing on Android)
# Package name must match `android.package` in app.json
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Web OAuth Client ID (only needed if running mobile in a browser)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
