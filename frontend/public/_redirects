# Netlify redirects for SPA routing
# This ensures that all routes serve index.html while preserving assets

# Don't redirect files in /assets/ directory
/assets/*  /assets/:splat  200

# Don't redirect static files
/*.js      /:splat         200
/*.css     /:splat         200
/*.png     /:splat         200
/*.jpg     /:splat         200
/*.jpeg    /:splat         200
/*.gif     /:splat         200
/*.svg     /:splat         200
/*.ico     /:splat         200
/*.woff    /:splat         200
/*.woff2   /:splat         200
/*.ttf     /:splat         200
/*.eot     /:splat         200

# Redirect all other requests to index.html for client-side routing
/*         /index.html     200

