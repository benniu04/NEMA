{
  "name": "nema",
  "version": "1.0.0",
  "description": "",
  "main": "backend/dist/server.js",
  "scripts": {
    "build": "cd backend && npm install && npm run build",
    "dev": "cd backend && npm run dev",
    "start": "node --max-old-space-size=384 backend/dist/server.js",
    "start:pm2": "pm2 start ecosystem.config.cjs --env production --no-daemon",
    "start:pm2:dev": "pm2 start ecosystem.config.cjs --env development",
    "start:balanced": "pm2-runtime start ecosystem.config.balanced.cjs --env production",
    "start:render-lite": "node --max-old-space-size=384 backend/dist/server.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "db:indexes": "node backend/scripts/createIndexes.js"
  },
  "type": "module",
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^4.6.2",
    "firebase": "^12.6.0",
    "pm2": "^5.3.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "typescript": "^5.7.2"
  }
}