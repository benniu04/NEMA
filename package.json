{
  "name": "nema",
  "version": "1.0.0",
  "description": "",
  "main": "backend/server.js",
  "scripts": {
    "dev": "nodemon --watch backend --watch .env backend/server.js",
    "start": "node --max-old-space-size=384 backend/server.js",
    "start:pm2": "pm2 start ecosystem.config.cjs --env production --no-daemon",
    "start:pm2:dev": "pm2 start ecosystem.config.cjs --env development",
    "start:balanced": "pm2 start ecosystem.config.balanced.cjs --env production --no-daemon",
    "start:render": "pm2 start ecosystem.config.render.cjs --env production --no-daemon",
    "start:render-lite": "node --max-old-space-size=384 backend/server.js",
    "stop:pm2": "pm2 stop nema-backend",
    "restart:pm2": "pm2 restart nema-backend",
    "reload:pm2": "pm2 reload nema-backend",
    "logs:pm2": "pm2 logs nema-backend",
    "logs:pm2:error": "pm2 logs nema-backend --err",
    "monitor:pm2": "pm2 monit",
    "status:pm2": "pm2 status",
    "delete:pm2": "pm2 delete nema-backend",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:verbose": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose",
    "db:indexes": "node backend/scripts/createIndexes.js",
    "db:analyze": "node backend/scripts/analyzeIndexUsage.js"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.817.0",
    "@aws-sdk/cloudfront-signer": "^3.921.0",
    "@aws-sdk/s3-request-presigner": "^3.817.0",
    "@fingerprintjs/fingerprintjs": "^4.6.2",
    "aws-sdk": "^2.1692.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-slow-down": "^2.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.2.2",
    "mongoose": "^8.14.2",
    "multer": "^2.0.0",
    "multer-s3": "^3.0.1",
    "nodemailer": "^7.0.3",
    "nodemon": "^3.1.10",
    "winston": "^3.18.3",
    "pm2": "^5.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4"
  }
}
